// ============================================================================
// relu.sycl —— Intel oneAPI/SYCL ReLU（修正线性单元）教学示例
//
// 本文件实现 y[i] = max(0, x[i])，数组长度为 N。
// 所有 kernel 都把输入输出当作“一维数组”看待，二维 (S, K) 矩阵在启动端
// 展平成 N = S * K。
//
// 对应 LeetCUDA/kernels/relu/relu.cu，包含 6 个计算版本：
//   1. f32         : FP32 标量版（每 work-item 1 个元素）
//   2. f32x4       : FP32 向量化版（每 work-item 4 个元素，16 字节访存）
//   3. f16         : FP16 标量版（sycl::half，每 work-item 1 个元素）
//   4. f16x2       : FP16 每 work-item 2 个元素（4 字节访存）
//   5. f16x8       : FP16 每 work-item 8 个元素（4 次 4 字节访存，unpack 写法）
//   6. f16x8_pack  : FP16 每 work-item 8 个元素（一次 16 字节/128 位访存）
//
// 与 elementwise / sigmoid 模块的关系：
// 本文件的 6 个版本与 kernels/elementwise/elementwise.sycl、
// kernels/sigmoid/sigmoid.sycl 的 6 个版本一一对应，区别只是把
// “c[i] = a[i] + b[i]” / “y[i] = sigmoid(x[i])” 换成 “y[i] = max(0, x[i])”。
// work-item 编号、向量化访存、FP16 打包等通用知识不再重复，下面重点说明
// ReLU 特有的两点：
//   - 计算极轻：只有一次取最大值，没有 exp、没有除法，所以
//     sigmoid 必须做的 clamp / 溢出保护（MAX_EXP_* 宏）在这里完全不需要；
//   - 与 sigmoid 的模板差异：ReLU 有成对的取最大值指令（CUDA 的 __hmax2，
//     SYCL 里是 sycl::fmax 的 vec<half,2> 重载），f16x8_pack 的循环
//     因此可以写成 i += 2；而 sigmoid 没有 hexp2，只能逐个 half 算。
//
// 学习重点：
// - 全局 work-item 编号 = item.get_global_id(0)
// - 越界保护：if (idx < N)
// - 逐元素算子可以“一个 work-item 算多个元素”，用更宽的访存换更少的访存指令
// - 当计算量小到可以忽略时，耗时基本由访存决定，
//   因此本模块也是观察 Intel GPU 显存带宽上限的最佳样本
//
// 须知：本文件严格照搬 CUDA 版 relu.cu 的算法与启动配置，**包括**
// f32x4 / f16x2 / f16x8 只判断段首下标、缺少 tail 分支（N 不是向量宽度整数倍
// 时会越界写），以及 f16x8_pack 尾部不足 8 个元素整段漏算的已知缺陷；
// 这些缺陷在本文件与 docs/relu/README.md 中照实标注，本次不修复。
//
// 文件后半部分是 PyTorch 绑定：把 SYCL kernel 包装成 Python 可调用的函数，
// 供 relu.py 编译与基准测试使用。运行环境要求 PyTorch XPU（Intel GPU 后端）。
// ============================================================================

// ============================================================================
// 【ReLU 曲线速览】一张小图看懂这个激活函数
//
//   y = max(0, x)
//
//  3.0 ┤                          ***
//      ┤                       ***
//  2.0 ┤                    ***
//      ┤                 ***
//  1.0 ┤              ***
//      ┤           ***
//  0.0 ┤***********+
//      └──────────────────────────────→ x
//      -3     -2    -1    0    1    2    3
//
// 采样值：-3→0、-1→0、0→0、1→1、2→2、3→3
// （负半轴被“整流”成 0，正半轴是恒等映射，这就是 Rectified 的来历）
//
// 读图要点：
// - 分段线性：x > 0 时 relu(x) = x，x <= 0 时 relu(x) = 0；
// - 值域是 [0, +∞)，不像 sigmoid 那样是 (0, 1) 的有界区间，两端都不饱和：
//   正半轴导数恒为 1，梯度不会随 x 增大而衰减，所以深网络里比 sigmoid
//   更不容易梯度消失——这是 ReLU 成为现代网络隐藏层默认选择的主因；
// - 在 x = 0 处不可导（左导 0、右导 1），工程上取次梯度，常用 0；
// - 负半轴导数恒为 0：若某个神经元的输出长期落在负半轴，它的梯度恒 0、
//   权重不再更新，即所谓“死亡 ReLU（dead ReLU）”，这也是 leaky ReLU /
//   GELU / SiLU 等变体出现的动机；
// - 计算量极低：整个算子只有一次比较/取最大值，没有 exp、没有除法，
//   所以它既是很好的入门示例，也可以当作同类逐元素算子的性能上限参照。
//
// 与 sigmoid 的对照（下文会反复引用这张表）：
//   | 对比项     | sigmoid                      | relu                         |
//   | 公式       | 1 / (1 + exp(-x))            | max(0, x)                    |
//   | 值域       | (0, 1)，两端饱和             | [0, +∞)，正半轴不饱和        |
//   | 每元素计算 | 一次 exp + 一次加法 + 一次除法 | 一次取最大值               |
//   | 溢出保护   | 必须 clamp 后再 exp          | 不需要（见下面的宏定义段）   |
//   | 成对指令   | 无 hexp2，只能逐分量算       | 有 __hmax2，一次算 2 个 half |
// ============================================================================

// 头文件列表与 elementwise / sigmoid 保持一致（其中若干头文件本模块没有
// 直接使用，保留是为了方便几个模块对照阅读）。CUDA 版的 cuda_fp16.h /
// cuda_runtime.h / float.h / stdio.h / stdlib.h 在 SYCL 侧不需要，
// half 类型与数学函数都由 <sycl/sycl.hpp> 提供。
#include <algorithm>
#include <cstddef>
#include <iostream>
#include <stdexcept>
#include <vector>

#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>
#include <torch/extension.h>
#include <torch/types.h>

// 常量：与 CUDA 版保持同一套启动策略
// ELEMS_PER_GROUP：一个 work-group 固定处理的元素数（对应 CUDA 里一个 block
//                  处理 256 个元素）
// MAX_GROUP_ITEMS：一个 work-group 的 work-item 数上限（对应 CUDA block 上限 1024）
#define ELEMS_PER_GROUP 256
#define MAX_GROUP_ITEMS 1024

// ----------------------------------------------------------------------------
// 向量类型别名
// CUDA 的 float4 / half2 在 SYCL 中对应 sycl::vec<T, N>：
//   float4 -> sycl::vec<float, 4>（4 × 4B = 16 字节）
//   half2  -> sycl::vec<sycl::half, 2>（2 × 2B = 4 字节）
//   half8  -> sycl::vec<sycl::half, 8>（8 × 2B = 16 字节，一次 128 位访存）
// ----------------------------------------------------------------------------
using float4_vec = sycl::vec<float, 4>;
using half2_vec = sycl::vec<sycl::half, 2>;
using half8_vec = sycl::vec<sycl::half, 8>;

// ----------------------------------------------------------------------------
// 访存“重解释（reinterpret）”宏
//
// GPU 一次访存指令能搬移的位宽有限。把一段连续内存 reinterpret 成更宽的
// SYCL 向量类型，可以让编译器生成更宽的 load/store 指令。
//
// 用法示例：
//   LOAD_FLOAT4(x + idx)        从 x[idx..idx+3] 一次读 16 字节成 vec<float,4>
//   STORE_FLOAT4(y + idx, val)  把 16 字节的 vec<float,4> 一次写回
//
// 要求 ptr 对应地址按向量大小对齐；torch 分配的 XPU 张量内存满足要求，
// 且 idx 取 4/2/8 的倍数，因此本文件中的用法保持对齐。
// ----------------------------------------------------------------------------
#define LOAD_FLOAT4(ptr) (*reinterpret_cast<const float4_vec *>(ptr))
#define STORE_FLOAT4(ptr, value) (*reinterpret_cast<float4_vec *>(ptr) = (value))

#define LOAD_HALF2(ptr) (*reinterpret_cast<const half2_vec *>(ptr))
#define STORE_HALF2(ptr, value) (*reinterpret_cast<half2_vec *>(ptr) = (value))

#define LOAD_HALF8(ptr) (*reinterpret_cast<const half8_vec *>(ptr))
#define STORE_HALF8(ptr, value) (*reinterpret_cast<half8_vec *>(ptr) = (value))

// 把 pack 数组里第 i 个 half 起的 2 个 half（4 字节）当成一个 vec<half,2>，
// 对应 CUDA 版 relu.cu 里的 HALF2(pack_x[i]) 宏。
#define HALF2_AT(ptr) (*reinterpret_cast<half2_vec *>(ptr))

// ----------------------------------------------------------------------------
// ReLU 的 half 版辅助函数
//
// 1. h_relu：标量 half 取最大值，对应 CUDA 的
//    __hmax(__float2half(0.0f), v)。必须用 half 重载，写成 float 版本会先
//    提升到 float、算完再转回来，多出两条转换指令。
// 2. h_relu2：成对 half 取最大值，对应 CUDA 的 __hmax2(v, z2)，
//    一次处理 vec<half,2> 里的 2 个分量（是否最终合成一条成对指令由后端决定，
//    但语义与 CUDA 的 __hmax2 一致，且写法上让循环可以按 i += 2 推进）。
//    与 sigmoid 的对照：sigmoid 没有成对的 hexp2，只能逐分量调用；
//    ReLU 有成对的取最大值，所以 f16x8_pack 的循环可以写成 i += 2。
// ----------------------------------------------------------------------------
static inline sycl::half h_relu(sycl::half v) {
  return sycl::fmax(sycl::half(0.0f), v);
}

static inline half2_vec h_relu2(half2_vec v) {
  // 常数 0 的 half2 形式：成对取最大值要求两个操作数同类型，
  // 这里显式构造一次（两个 sycl::half(0.0f) 都是字面量，会被折叠）
  const half2_vec z2 = half2_vec(sycl::half(0.0f), sycl::half(0.0f));
  return sycl::fmax(v, z2);
}

// ----------------------------------------------------------------------------
// 为什么本文件没有 sigmoid 那样的 MAX_EXP_* 边界宏？
//
// sigmoid 要先算 exp(-x) 再取倒数，exp 的参数太大就会溢出成 inf，
// 所以它必须先把 x 夹在 [MIN_EXP_F32, MAX_EXP_F32]（FP16 是 16 位版本）之内。
//
// ReLU 只需要一次取最大值：
//   - x 是很大的正数：原样返回，不会产生新的数值，也就不会溢出；
//   - x 是很大的负数：被截断成 0；
//   - x 是 ±inf：得到 +inf / 0。
// 结果一定落在 [0, +∞) 内，全程不需要夹取，因此不需要任何边界宏。
//
// 唯一需要留意的是 NaN 的处理，见 Kernel 1 内的说明。
// ----------------------------------------------------------------------------

// ============================================================================
// Kernel 1：FP32 标量版（最朴素写法，作为正确性基准）
// ============================================================================
//
// ---- 调用链：谁触发了这个 kernel？ ----
// relu.py
//   └─ lib.relu_f32(x, y)                        # Python 调用（pybind11）
//       └─ relu_f32(torch::Tensor x, y)          # C++ host 包装函数（宏生成，
//                                                #  运行在 CPU 上）
//           └─ submit_relu_f32(queue, ...)       # 本函数
//               └─ queue.submit(parallel_for)    # SYCL 提交（对应 CUDA 启动语法）
//                   └─ Intel GPU 硬件并行执行 kernel lambda
//
// 关键点：
// - CUDA 用 <<<grid, block>>> 启动 __global__ 函数；SYCL 在 host 端用
//   queue.submit + parallel_for 提交 kernel lambda；
// - CUDA kernel 靠 blockIdx/threadIdx 算全局编号；SYCL 靠 nd_item
//   （这里叫 item）的 get_global_id(0)；
// - 启动后 GPU 的每个 work-item 都会执行一遍本函数体。
//
// 与 elementwise 的差异：这是单输入算子，只有 x 一路读、y 一路写。
//
// 参数：
//   x : 输入数组（设备端指针）
//   y : 输出数组
//   N : 元素个数
// ============================================================================
static void submit_relu_f32(sycl::queue &queue, const float *x, float *y, int N,
                            size_t global_range, size_t local_range) {
  queue.submit([&](sycl::handler &h) {
    // nd_range 分两层：global（总 work-item 数）与 local（每个 work-group 大小）
    h.parallel_for<class ReluF32Kernel>(
        sycl::nd_range<1>(sycl::range<1>(global_range),
                          sycl::range<1>(local_range)),
        // [=]：kernel lambda 只能按值捕获设备可访问的指针/标量
        [=](sycl::nd_item<1> item) {
          // 全局 work-item 编号：get_global_id(0) 相当于 CUDA 的
          // blockIdx.x * blockDim.x + threadIdx.x
          int idx = static_cast<int>(item.get_global_id(0));
          // 越界保护：N 不一定是启动 work-item 总数的整数倍，多余的不参与计算
          if (idx < N) {
            // sycl::fmax 是 float 版本的取最大值函数，对应 CUDA 的 fmaxf
            // （CUDA 里不能写成 fmax，那是 double 版本，会把参数提升成 double
            // 再比较，明显更慢）。
            // 参数顺序写成「0.0f 在前」只是习惯写法：除 NaN 外 fmax 是对称的。
            // NaN 语义：IEEE 754-2008 的 maxNum 规定“一个参数是 NaN 时返回
            // 另一个参数”，所以 fmax(NaN, 0.0f) == 0.0f，即本 kernel 会把
            // NaN 输入清成 0；而 PyTorch 的 torch.relu 会把 NaN 传播到输出。
            // 本模块基准测试的输入由 torch.randn 生成（有限值），不会触发该差异。
            y[idx] = sycl::fmax(0.0f, x[idx]);
          }
        });
  });
}

// ============================================================================
// Kernel 2：FP32 向量化版（vec<float,4> = 4 个 float = 16 字节）
// ============================================================================
// 每个 work-item 连续处理 4 个元素，一次 16 字节的向量 load/store
// 代替 4 次 4 字节访存，从而减少访存指令条数。
//
// 与 elementwise 的 f32x4 不同，ReLU 是单输入算子：只读 x 一份数据，
// 没有 b 侧的第二路 load。
//
// ReLU 的计算只有 4 次取最大值，比 sigmoid 的 4 次 exp 轻得多，
// 所以“省下的访存指令”更容易直接体现在耗时上；反过来，当规模大到已经
// 吃满显存带宽时，向量化也就不会再有额外收益（见 README 的实测数据）。
//
// host 端对应启动：local = 256 / 4 = 64 个 work-item，每个 work-group
// 仍处理 256 个元素。
//
// 已知缺陷（照搬 CUDA 版，本模块不修复）：只判断了 (idx + 0) < N，
// 没有像 elementwise 的 f32x4 那样用 (idx + 3) < N 判断整段 4 个元素是否齐全，
// 也没有尾部（tail）逐元素回退分支。当 N 不是 4 的整数倍时，末尾 work-item
// 会把 idx+1..idx+3 写到 y 的合法范围之外。
// 本模块基准测试的 S/K 都是 256 的倍数，不会触发该问题。
// ============================================================================
static void submit_relu_f32x4(sycl::queue &queue, const float *x, float *y,
                              int N, size_t global_range, size_t local_range) {
  queue.submit([&](sycl::handler &h) {
    h.parallel_for<class ReluF32x4Kernel>(
        sycl::nd_range<1>(sycl::range<1>(global_range),
                          sycl::range<1>(local_range)),
        [=](sycl::nd_item<1> item) {
          // 基础编号 t 对应“第 t 组 4 元素”的起点，真实下标是 4 * t
          int idx = 4 * static_cast<int>(item.get_global_id(0));
          // 读取写在越界判断内部（照搬 CUDA 版 relu_f32x4_kernel 的写法；
          // sigmoid.sycl 的向量化版本把读取放在判断之外，两者在这一点上不同）
          if (idx < N) {
            // 把 x[idx..idx+3] 的 16 字节 reinterpret 成 vec<float,4>，一次读入
            float4_vec reg_x = LOAD_FLOAT4(x + idx);
            // 结果也用 vec<float,4> 暂存，最后一次性写回
            float4_vec reg_y;
            // 对 4 个分量分别取最大值（vec<float,4> 的分量下标是 0/1/2/3，
            // 对应 CUDA float4 的 x/y/z/w）
            reg_y[0] = sycl::fmax(0.0f, reg_x[0]);
            reg_y[1] = sycl::fmax(0.0f, reg_x[1]);
            reg_y[2] = sycl::fmax(0.0f, reg_x[2]);
            reg_y[3] = sycl::fmax(0.0f, reg_x[3]);
            // 一次 16 字节写回 y[idx..idx+3]
            // 注意：这里只覆盖了 (idx + 0) < N 的情况，缺尾部处理，见上面的说明
            STORE_FLOAT4(y + idx, reg_y);
          }
        });
  });
}

// ============================================================================
// Kernel 3：FP16 标量版
// ============================================================================
// sycl::half 是 IEEE 754 半精度浮点，只占 2 字节（float 的一半）。
// 相同显存带宽下，FP16 理论上能搬运两倍元素，代价是精度更低
// （half 约 3~4 位十进制有效数字，保守按约 3 位）。
//
// 与 sigmoid 的 f16 版本相比，这里少了一处常量复用：
// sigmoid 要预先算好 const half f = __float2half(1.0f)，是因为它留在例子里的
// 常量 1 要在分子分母各出现一次；ReLU 只需要一个 0，而
// sycl::half(0.0f) 的参数是字面量，编译器会直接折叠成 half 常量，
// 不会产生运行时的类型转换开销。
//
// 取最大值要用 half 版本的 sycl::fmax（直接比较 16 位 half），写成 float
// 版本会先把 half 提升到 float、算完再转回来，多出两条转换指令。
// ============================================================================
static void submit_relu_f16(sycl::queue &queue, const sycl::half *x,
                            sycl::half *y, int N, size_t global_range,
                            size_t local_range) {
  queue.submit([&](sycl::handler &h) {
    h.parallel_for<class ReluF16Kernel>(
        sycl::nd_range<1>(sycl::range<1>(global_range),
                          sycl::range<1>(local_range)),
        [=](sycl::nd_item<1> item) {
          // 与 Kernel 1 相同的全局编号方式：一个 work-item 一个元素
          int idx = static_cast<int>(item.get_global_id(0));
          // 越界保护：多余的 work-item 不参与计算
          if (idx < N) {
            // h_relu 比较两个 half 标量并返回较大者，较大的那个写回 y
            // （对应 CUDA 的 __hmax(__float2half(0.0f), x[idx])）
            y[idx] = h_relu(x[idx]);
          }
        });
  });
}

// ============================================================================
// Kernel 4：FP16 每 work-item 2 个元素（vec<half,2> = 2 个 half = 4 字节）
// ============================================================================
// vec<half,2> 是 2 元素 half 向量，一次 load/store 4 字节，
// 每 work-item 一次处理 2 个连续元素。
//
// ReLU 其实有成对指令（CUDA 的 __hmax2 / SYCL 的 sycl::fmax 向量重载），
// 但本 kernel 为了与 elementwise / sigmoid 的 f16x2 保持一致的“逐分量展开”
// 写法，仍按 reg_y[0] / reg_y[1] 两行分别计算，成对指令的用法放在 Kernel 6。
//
// 已知缺陷（照搬 CUDA 版，本模块不修复）：同 Kernel 2，只判断 (idx + 0) < N，
// 缺少尾部处理，当 N 不是 2 的整数倍时会把 y[idx + 1] 写到范围之外。
// ============================================================================
static void submit_relu_f16x2(sycl::queue &queue, const sycl::half *x,
                              sycl::half *y, int N, size_t global_range,
                              size_t local_range) {
  queue.submit([&](sycl::handler &h) {
    h.parallel_for<class ReluF16x2Kernel>(
        sycl::nd_range<1>(sycl::range<1>(global_range),
                          sycl::range<1>(local_range)),
        [=](sycl::nd_item<1> item) {
          // 每 work-item 负责以 idx 为起点的 2 个连续 half
          int idx = 2 * static_cast<int>(item.get_global_id(0));
          if (idx < N) {
            // 从 x[idx..idx+1] 读 4 字节为一个 vec<half,2>
            half2_vec reg_x = LOAD_HALF2(x + idx);
            // 先读一次 y 只是为了拿到一个 vec<half,2> 类型的变量；
            // 紧随其后的两行会把 reg_y 的两个分量全部覆盖，所以这次读取属于
            // 冗余访存（照搬 CUDA 版，本次只补充注释）。
            half2_vec reg_y = LOAD_HALF2(y + idx);
            // vec<half,2> 只有 0、1 两个分量（对应 CUDA half2 的 x、y），
            // 分别取最大值
            reg_y[0] = h_relu(reg_x[0]);
            reg_y[1] = h_relu(reg_x[1]);
            // 一次写回 4 字节（2 个 half）
            // 注意：同 Kernel 2，这里只覆盖了 (idx + 0) < N，缺尾部处理
            STORE_HALF2(y + idx, reg_y);
          }
        });
  });
}

// ============================================================================
// Kernel 5：FP16 每 work-item 8 个元素（用 4 次 vec<half,2> 操作完成，
// unpack 写法）
// ============================================================================
// 每个 work-item 负责 8 个连续 half，把它们拆成 4 个 vec<half,2>
// （reg_x_0..3）处理。相比 f16x2，每个 work-item 做更多工作，能摊薄索引
// 计算等固定开销。
//
// 这里的 “unpack” 指：数据在内存里本就是连续的 8 个 half，
// 本 kernel 不把它整体打包搬运，而是按 half2 逐段读、逐段写。
//
// 注意 4 次 LOAD_HALF2 读取是无条件执行的，越界判断只出现在写回处。
//
// 已知缺陷（照搬 CUDA 版，本模块不修复）：写回时逐个 half2 判断起始下标，
// 只保证段首不越界。当 N 落在 idx+7 时，(idx + 6) < N 依然成立，
// 会把 y[idx + 7] 写到范围之外；尾部不足 8 个元素也没有回退分支。
// ============================================================================
static void submit_relu_f16x8(sycl::queue &queue, const sycl::half *x,
                              sycl::half *y, int N, size_t global_range,
                              size_t local_range) {
  queue.submit([&](sycl::handler &h) {
    h.parallel_for<class ReluF16x8Kernel>(
        sycl::nd_range<1>(sycl::range<1>(global_range),
                          sycl::range<1>(local_range)),
        [=](sycl::nd_item<1> item) {
          // 每 work-item 负责以 idx 为起点的 8 个连续 half
          int idx = 8 * static_cast<int>(item.get_global_id(0));
          // 一次读入 4 个 half2：覆盖 x[idx .. idx+7]（读取在判断之外，照搬
          // CUDA 版）
          half2_vec reg_x_0 = LOAD_HALF2(x + idx + 0);
          half2_vec reg_x_1 = LOAD_HALF2(x + idx + 2);
          half2_vec reg_x_2 = LOAD_HALF2(x + idx + 4);
          half2_vec reg_x_3 = LOAD_HALF2(x + idx + 6);
          // 结果也用 4 个 half2 保存
          half2_vec reg_y_0, reg_y_1, reg_y_2, reg_y_3;
          // 8 个分量分别取最大值（4 个 half2 × 2 个分量）
          reg_y_0[0] = h_relu(reg_x_0[0]);
          reg_y_0[1] = h_relu(reg_x_0[1]);
          reg_y_1[0] = h_relu(reg_x_1[0]);
          reg_y_1[1] = h_relu(reg_x_1[1]);
          reg_y_2[0] = h_relu(reg_x_2[0]);
          reg_y_2[1] = h_relu(reg_x_2[1]);
          reg_y_3[0] = h_relu(reg_x_3[0]);
          reg_y_3[1] = h_relu(reg_x_3[1]);
          // 结果写回 y[idx .. idx+7]，逐段判断起始下标（只保证段首不越界）
          if ((idx + 0) < N) {
            STORE_HALF2(y + idx + 0, reg_y_0);
          }
          if ((idx + 2) < N) {
            STORE_HALF2(y + idx + 2, reg_y_1);
          }
          if ((idx + 4) < N) {
            STORE_HALF2(y + idx + 4, reg_y_2);
          }
          if ((idx + 6) < N) {
            STORE_HALF2(y + idx + 6, reg_y_3);
          }
        });
  });
}

// ============================================================================
// Kernel 6：FP16 每 work-item 8 个元素（128 位打包版）
// ============================================================================
// 8 个 half 恰好是 16 字节 = 128 位。CUDA 版把局部数组 reinterpret 成
// float4 做整体搬运；SYCL 版直接使用 vec<half, 8>，把 x[idx..idx+7]
// 看作一个 16 字节向量，一次 load/store 128 位，比 Kernel 5 的多条 4 字节
// 访存指令更少。
//
// 与 elementwise / sigmoid 的 f16x8_pack 一样，这里的 “pack” 指的是把连续
// 8 个 half 整体当作 128 位向量搬运；计算部分仍是按 half 粒度处理。
//
// 计算部分的差异值得和 sigmoid 对照：
//   sigmoid : 没有 hexp2，循环只能 for (int i = 0; i < 8; ++i) 逐个 half 算；
//   relu    : 有 __hmax2（SYCL 里是 sycl::fmax 的 vec<half,2> 重载），
//             循环写成 for (int i = 0; i < 8; i += 2)，
//             一次处理一个 half2（2 个 half），8 个元素只需 4 次成对指令。
//
// 已知缺陷（照搬 CUDA 版，本模块不修复）：这里只在 (idx + 7) < N 时写回，
// 末尾不足 8 个元素的整段会被直接丢弃（漏算），但不会像 Kernel 2/4/5 那样
// 越界写。本模块基准测试的 S/K 都是 256 的倍数，不会触发该问题。
// ============================================================================
static void submit_relu_f16x8_pack(sycl::queue &queue, const sycl::half *x,
                                   sycl::half *y, int N, size_t global_range,
                                   size_t local_range) {
  queue.submit([&](sycl::handler &h) {
    h.parallel_for<class ReluF16x8PackKernel>(
        sycl::nd_range<1>(sycl::range<1>(global_range),
                          sycl::range<1>(local_range)),
        [=](sycl::nd_item<1> item) {
          // 每 work-item 负责以 idx 为起点的 8 个连续 half
          int idx = 8 * static_cast<int>(item.get_global_id(0));
          // 把 x[idx..idx+7] 的 16 字节整体 reinterpret 成 vec<half,8>，
          // 用一条访存指令读入 128 位（读取仍在判断之外，照搬 CUDA 版）
          half8_vec pack_x = LOAD_HALF8(x + idx);
          // 结果也用 vec<half,8>（16 字节）保存，
          // 对应 CUDA 版可寻址的局部数组 half pack_y[8]
          half8_vec pack_y;

#pragma unroll
          for (int i = 0; i < 8; i += 2) {
            // __hmax2 / sycl::fmax(vec<half,2>) 一次处理 2 个 half：
            // HALF2_AT(&pack_x[i]) 把 pack_x[i]、pack_x[i+1] 这两个 half
            // 重解释成一个 vec<half,2>，成对取最大值后写回 pack_y[i]、pack_y[i+1]
            HALF2_AT(&pack_y[i]) = h_relu2(HALF2_AT(&pack_x[i]));
          }
          // 结果 pack_y[0..7] 共 128 位，一条 store 指令整体写回 y[idx..idx+7]
          if ((idx + 7) < N) {
            STORE_HALF8(y + idx, pack_y);
          }
        });
  });
}

// ----------------------------------------------------------------------------
// 字符串化宏：把函数名转成字符串，供 PYBIND11 注册 Python 函数时使用。
// #str 会把参数按字面内容生成字符串，例如 STRINGFY(relu_f32) 得到
// "relu_f32"。
// ----------------------------------------------------------------------------
#define STRINGFY(str) #str
#define TORCH_BINDING_COMMON_EXTENSION(func)                                   \
  m.def(STRINGFY(func), &func, STRINGFY(func));

// ----------------------------------------------------------------------------
// 类型检查宏：确保传入的 torch::Tensor 是期望的 dtype，
// 否则打印张量信息并抛出运行时异常，避免把错误类型交给 kernel。
// ----------------------------------------------------------------------------
#define CHECK_TORCH_TENSOR_DTYPE(T, th_type)                                   \
  if (((T).options().dtype() != (th_type))) {                                  \
    std::cout << "Tensor Info:" << (T).options() << std::endl;                 \
    throw std::runtime_error("values must be " #th_type);                      \
  }

// ============================================================================
// host 启动函数生成宏
//
// 宏参数：
//   packed_type : 命名后缀，如 f32 / f32x4 / f16x8_pack
//   th_type     : 对应的 torch dtype（torch::kFloat32 / torch::kHalf）
//   element_type: kernel 中的 C++ 数据类型（float / sycl::half）
//   n_elements  : 每个 work-item 一次处理的元素个数（向量宽度）
//
// 展开后生成形如 relu_f32(torch::Tensor x, torch::Tensor y) 的函数：
//   1. 校验输入、输出张量的 dtype 与 XPU 设备，并检查两者形状一致；
//   2. 根据张量形状计算 nd_range 的 global / local；
//   3. 用 data_ptr() 拿裸指针并从当前 XPU stream 取 sycl::queue 提交 kernel。
//
// 启动策略（与 elementwise / sigmoid 一致）：
// - 非二维张量：展平成 N，每个 work-group 固定处理 256 个元素，
//   所以 local = 256 / n_elements，global = ceil(N / 256) * local；
// - 二维 (S, K)：每行需要的 work-item 数不超过 1024 且能被向量宽度整除时，
//   采用“一行一个 work-group”（local = K / n_elements，global = S * local）；
//   否则回退到上面的展平策略。
//
// 与 CUDA 版的差异：CUDA 的 TORCH_BINDING_RELU 只判断了
// (K / n_elements) <= 1024，没有“大于 0”与“能被整除”两项检查；
// 这里沿用 elementwise / sigmoid 模块的 3 项检查，行不可整除时回退到展平启动，
// 避免 CUDA 版在 K 不能被向量宽度整除时静默漏算每行末尾几个元素。
//
// 宏内注释统一使用 /* ... */ 块注释：宏定义每行以 \ 续行，用 // 会把该行末尾的
// 续行符一起注释掉，导致宏定义断开；块注释在预处理阶段被替换为空格，不影响续行。
// ============================================================================
#define TORCH_BINDING_RELU(packed_type, th_type, element_type, n_elements)    \
  void relu_##packed_type(torch::Tensor x, torch::Tensor y) {                 \
    /* ① dtype 检查：输入输出都必须是 th_type */                              \
    CHECK_TORCH_TENSOR_DTYPE(x, (th_type))                                    \
    CHECK_TORCH_TENSOR_DTYPE(y, (th_type))                                    \
    /* ② 设备检查：kernel 只在 Intel GPU 上执行 */                            \
    TORCH_CHECK(x.device().is_xpu(), "x must be an XPU tensor");              \
    TORCH_CHECK(y.device().is_xpu(), "y must be an XPU tensor");              \
    /* ③ 形状检查：relu 是逐元素算子，输入输出形状必须一致 */                 \
    TORCH_CHECK(x.sizes() == y.sizes(), "x/y must have the same shape");      \
    /* ④ ndim：二维 (S, K) 单独分支，其余按一维展平 */                        \
    const int ndim = x.dim();                                                 \
    /* ⑤ 取输入/输出裸指针（XPU 张量内存即 SYCL USM，可直接交给 kernel） */   \
    const element_type *x_ptr =                                               \
        reinterpret_cast<const element_type *>(x.data_ptr());                 \
    element_type *y_ptr = reinterpret_cast<element_type *>(y.data_ptr());     \
    /* ⑥ 从当前 XPU stream 取 sycl::queue，保证与 PyTorch 流一致 */           \
    sycl::queue &queue = c10::xpu::getCurrentXPUStream().queue();             \
    /* ⑦ 每个 work-item 一次处理的元素个数（向量宽度） */                     \
    const size_t n_elem_per_item = (n_elements);                              \
    /* ⑧ N：元素总数，二维时即 S * K */                                       \
    int N = 1;                                                                \
    for (int i = 0; i < ndim; ++i) {                                          \
      N *= static_cast<int>(x.size(i));                                       \
    }                                                                         \
    size_t global_range = 0;                                                  \
    size_t local_range = 0;                                                   \
    if (ndim != 2) {                                                          \
      /* 非二维张量：展平启动，每个 work-group 处理 256 个元素 */             \
      local_range = ELEMS_PER_GROUP / n_elem_per_item;                        \
      const size_t num_groups =                                               \
          (static_cast<size_t>(N) + ELEMS_PER_GROUP - 1) / ELEMS_PER_GROUP;   \
      global_range = num_groups * local_range;                                \
    } else {                                                                  \
      const int S = static_cast<int>(x.size(0));                              \
      const int K = static_cast<int>(x.size(1));                              \
      const size_t items_per_row = K / n_elem_per_item;                       \
      if (items_per_row > 0 && items_per_row <= MAX_GROUP_ITEMS &&            \
          (K % n_elem_per_item) == 0) {                                       \
        /* 二维且一行放得下：一行一个 work-group */                           \
        local_range = items_per_row;                                          \
        global_range = static_cast<size_t>(S) * local_range;                  \
      } else {                                                                \
        /* 行过长/不可整除：回退到展平启动 */                                 \
        local_range = ELEMS_PER_GROUP / n_elem_per_item;                      \
        const size_t num_groups =                                             \
            (static_cast<size_t>(N) + ELEMS_PER_GROUP - 1) / ELEMS_PER_GROUP; \
        global_range = num_groups * local_range;                              \
      }                                                                       \
    }                                                                         \
    submit_relu_##packed_type(queue, x_ptr, y_ptr, N, global_range,           \
                              local_range);                                   \
  }

// 实例化 6 个 host 启动函数，分别对应 6 个 kernel：
//   f32         : float，每 work-item 1 元素
//   f32x4       : float，每 work-item 4 元素（float4）
//   f16         : sycl::half，每 work-item 1 元素
//   f16x2       : sycl::half，每 work-item 2 元素（half2）
//   f16x8       : sycl::half，每 work-item 8 元素（4 次 half2，unpack）
//   f16x8_pack  : sycl::half，每 work-item 8 元素（128 位打包访存）
TORCH_BINDING_RELU(f32, torch::kFloat32, float, 1)
TORCH_BINDING_RELU(f32x4, torch::kFloat32, float, 4)
TORCH_BINDING_RELU(f16, torch::kHalf, sycl::half, 1)
TORCH_BINDING_RELU(f16x2, torch::kHalf, sycl::half, 2)
TORCH_BINDING_RELU(f16x8, torch::kHalf, sycl::half, 8)
TORCH_BINDING_RELU(f16x8_pack, torch::kHalf, sycl::half, 8)

// ============================================================================
// PyTorch C++ 扩展模块入口
//
// TORCH_EXTENSION_NAME 由 PyTorch 在编译时注入（这里实际是 relu_lib）。
// m.def 把上面生成的 6 个函数注册为 Python 模块里的同名函数，
// 之后 Python 里就可以直接调用 lib.relu_f32(...) 等。
// ============================================================================
PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
  // 逐个把 C++ host 函数暴露给 Python
  TORCH_BINDING_COMMON_EXTENSION(relu_f32)
  TORCH_BINDING_COMMON_EXTENSION(relu_f32x4)
  TORCH_BINDING_COMMON_EXTENSION(relu_f16)
  TORCH_BINDING_COMMON_EXTENSION(relu_f16x2)
  TORCH_BINDING_COMMON_EXTENSION(relu_f16x8)
  TORCH_BINDING_COMMON_EXTENSION(relu_f16x8_pack)
}
